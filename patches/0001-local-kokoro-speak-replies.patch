@@ -946,6 +946,127 @@ async def speech_health(request: Request):
     }
 
 
+def _plain_text_for_tts(text: str) -> str:
+    """Lightly strip markdown so spoken replies sound more natural."""
+    import re
+
+    cleaned = re.sub(r"```[\s\S]*?```", " ", text)
+    cleaned = re.sub(r"`([^`]+)`", r"\1", cleaned)
+    cleaned = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", cleaned)
+    cleaned = re.sub(r"[#*_>]+", "", cleaned)
+    cleaned = re.sub(r"\s+", " ", cleaned).strip()
+    return cleaned
+
+
+@speech_router.get("/tts/health")
+async def tts_health(request: Request):
+    """Check if a text-to-speech backend is available."""
+    backend = getattr(request.app.state, "tts_backend", None)
+    if backend is None:
+        return {
+            "available": False,
+            "reason": (
+                "No TTS backend configured. Install Kokoro with: "
+                "uv pip install kokoro soundfile"
+            ),
+        }
+    try:
+        available = backend.health() if hasattr(backend, "health") else True
+        reason = None
+    except Exception as exc:
+        logger.exception("TTS health check failed")
+        available = False
+        reason = str(exc)
+    return {
+        "available": bool(available),
+        "backend": getattr(backend, "backend_id", "unknown"),
+        **({"reason": reason} if reason else {}),
+    }
+
+
+@speech_router.post("/synthesize")
+async def synthesize_speech(request: Request):
+    """Synthesize text to spoken audio using the configured TTS backend."""
+    from fastapi.responses import Response
+
+    backend = getattr(request.app.state, "tts_backend", None)
+    if backend is None:
+        raise HTTPException(
+            status_code=501,
+            detail=(
+                "TTS backend not configured. Install Kokoro with: "
+                "uv pip install kokoro soundfile"
+            ),
+        )
+
+    try:
+        payload = await request.json()
+    except Exception as exc:
+        raise HTTPException(status_code=400, detail="Invalid JSON body") from exc
+
+    text = str(payload.get("text", "")).strip()
+    if not text:
+        raise HTTPException(status_code=400, detail="Missing 'text' field")
+
+    # Guardrail against accidental huge synthesis jobs.
+    if len(text) > 4000:
+        text = text[:4000]
+
+    config = getattr(request.app.state, "config", None)
+    voice_id = str(payload.get("voice_id") or "").strip()
+    if not voice_id and config is not None:
+        voice_id = getattr(config.speech, "tts_voice_id", "") or ""
+    if not voice_id:
+        voice_id = "am_adam"
+
+    speed = payload.get("speed")
+    if speed is None and config is not None:
+        speed = getattr(config.speech, "tts_speed", 1.0)
+    try:
+        speed_f = float(speed if speed is not None else 1.0)
+    except (TypeError, ValueError):
+        speed_f = 1.0
+
+    plain = _plain_text_for_tts(text)
+    if not plain:
+        raise HTTPException(status_code=400, detail="No speakable text after cleanup")
+
+    try:
+        result = await asyncio.to_thread(
+            backend.synthesize,
+            plain,
+            voice_id=voice_id,
+            speed=speed_f,
+        )
+    except Exception as exc:
+        logger.exception("TTS synthesis failed")
+        raise HTTPException(
+            status_code=500,
+            detail=f"TTS synthesis failed: {exc}",
+        ) from exc
+
+    audio = getattr(result, "audio", b"") or b""
+    if not audio:
+        raise HTTPException(status_code=500, detail="TTS backend returned empty audio")
+
+    fmt = (getattr(result, "format", None) or "wav").lower()
+    media_types = {
+        "wav": "audio/wav",
+        "mp3": "audio/mpeg",
+        "ogg": "audio/ogg",
+        "flac": "audio/flac",
+    }
+    return Response(
+        content=audio,
+        media_type=media_types.get(fmt, "application/octet-stream"),
+        headers={
+            "X-TTS-Backend": getattr(backend, "backend_id", "unknown"),
+            "X-TTS-Voice": getattr(result, "voice_id", voice_id) or voice_id,
+            "X-TTS-Format": fmt,
+        },
+    )
+
