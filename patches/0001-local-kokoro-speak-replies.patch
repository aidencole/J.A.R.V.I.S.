+
+def _create_tts_backend(
+    key: str,
+    config: "JarvisConfig",
+) -> Optional["TTSBackend"]:
+    """Try to instantiate a TTS backend by registry key."""
+    from openjarvis.core.registry import TTSRegistry
+
+    if not TTSRegistry.contains(key):
+        return None
+
+    try:
+        backend_cls = TTSRegistry.get(key)
+        if key == "openai_tts":
+            api_key = os.environ.get("OPENAI_API_KEY", "")
+            if not api_key:
+                return None
+            return backend_cls(api_key=api_key)
+        if key == "cartesia":
+            api_key = os.environ.get("CARTESIA_API_KEY", "")
+            if not api_key:
+                return None
+            return backend_cls(api_key=api_key)
+        backend = backend_cls()
+        # Skip local backends that are registered but not installable yet.
+        if hasattr(backend, "health") and not backend.health():
+            return None
+        return backend
+    except Exception:
+        return None
+
+
+def get_tts_backend(config: "JarvisConfig") -> Optional["TTSBackend"]:
+    """Resolve the TTS backend from config.
+
+    If ``config.speech.tts_backend`` is ``"auto"``, prefers local Kokoro,
+    then cloud backends when API keys are present.
+    """
+    import openjarvis.speech  # noqa: F401
+
+    backend_key = getattr(config.speech, "tts_backend", "auto") or "auto"
+    aliases = {"openai": "openai_tts"}
+    backend_key = aliases.get(backend_key, backend_key)
+
+    if backend_key != "auto":
+        return _create_tts_backend(backend_key, config)
+
+    for key in TTS_DISCOVERY_ORDER:
+        backend = _create_tts_backend(key, config)
+        if backend is not None:
+            return backend
+
+    return None
