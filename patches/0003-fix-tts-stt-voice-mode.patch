diff --git a/frontend/src/lib/api.ts b/frontend/src/lib/api.ts
index e876930..7336f47 100644
--- a/frontend/src/lib/api.ts
+++ b/frontend/src/lib/api.ts
@@ -332,13 +332,18 @@ export interface SpeechHealth {
   reason?: string;
 }
 
-export async function transcribeAudio(audioBlob: Blob, filename = 'recording.webm'): Promise<TranscriptionResult> {
+export async function transcribeAudio(
+  audioBlob: Blob,
+  filename = 'recording.webm',
+  language = 'en',
+): Promise<TranscriptionResult> {
   if (isTauri()) {
     try {
       const buffer = await audioBlob.arrayBuffer();
       return await tauriInvoke<TranscriptionResult>('transcribe_audio', {
         audioData: Array.from(new Uint8Array(buffer)),
         filename,
+        language,
       });
     } catch (err) {
       const msg = err instanceof Error ? err.message : String(err);
@@ -347,6 +352,7 @@ export async function transcribeAudio(audioBlob: Blob, filename = 'recording.web
   }
   const formData = new FormData();
   formData.append('file', audioBlob, filename);
+  if (language) formData.append('language', language);
   const res = await apiFetch(`/v1/speech/transcribe`, {
     method: 'POST',
     body: formData,
@@ -412,6 +418,26 @@ export async function synthesizeSpeech(
 
 let _speakAudio: HTMLAudioElement | null = null;
 let _speakResolve: (() => void) | null = null;
+let _audioUnlocked = false;
+
+/**
+ * Call during a user gesture (button click) so later TTS playback is allowed.
+ * Browsers often block audio after async gaps unless audio was unlocked first.
+ */
+export async function unlockAudio(): Promise<void> {
+  try {
+    const silent = new Audio(
+      'data:audio/wav;base64,UklGRigAAABXQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgAZGF0YQQAAAAAAA==',
+    );
+    silent.volume = 0.01;
+    await silent.play();
+    silent.pause();
+    silent.src = '';
+    _audioUnlocked = true;
+  } catch {
+    _audioUnlocked = false;
+  }
+}
 
 /** Stop any in-progress spoken reply (used for barge-in / Voice Mode interrupt). */
 export function stopSpeaking(): void {
@@ -432,22 +458,44 @@ export async function speakText(text: string): Promise<void> {
   const trimmed = text.trim();
   if (!trimmed) return;
   stopSpeaking();
+  if (!_audioUnlocked) {
+    await unlockAudio();
+  }
   const blob = await synthesizeSpeech(trimmed);
   const url = URL.createObjectURL(blob);
   const audio = new Audio(url);
+  audio.setAttribute('playsinline', 'true');
   _speakAudio = audio;
 
-  await new Promise<void>((resolve) => {
-    const finish = () => {
+  await new Promise<void>((resolve, reject) => {
+    let settled = false;
+    const finishOk = () => {
+      if (settled) return;
+      settled = true;
       URL.revokeObjectURL(url);
       if (_speakAudio === audio) _speakAudio = null;
-      if (_speakResolve === finish) _speakResolve = null;
+      if (_speakResolve === finishOk) _speakResolve = null;
       resolve();
     };
-    _speakResolve = finish;
-    audio.onended = finish;
-    audio.onerror = finish;
-    audio.play().catch(() => finish());
+    const finishErr = (err: Error) => {
+      if (settled) return;
+      settled = true;
+      URL.revokeObjectURL(url);
+      if (_speakAudio === audio) _speakAudio = null;
+      _speakResolve = null;
+      reject(err);
+    };
+    _speakResolve = finishOk;
+    audio.onended = finishOk;
+    audio.onerror = () => finishErr(new Error('Audio playback failed'));
+    audio.play().catch((err) => {
+      const msg = err instanceof Error ? err.message : String(err);
+      finishErr(
+        new Error(
+          `Browser blocked or failed audio playback: ${msg}. Click Voice Mode again, keep the tab focused, and check system volume.`,
+        ),
+      );
+    });
   });
 }
 
