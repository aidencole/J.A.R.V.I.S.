 frontend/src/hooks/useVoiceConversation.ts   | 24 +++++---
 frontend/src/lib/api.ts                      | 64 +++++++++++++++++---
 src/openjarvis/speech/faster_whisper.py      |  6 +-
 4 files changed, 79 insertions(+), 18 deletions(-)

