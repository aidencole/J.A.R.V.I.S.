+    const speechStartMs = phaseNow === 'speaking' ? 160 : 220;
+    // Wait longer before cutting so trailing words are not clipped.
+    const silenceEndMs = 1100;
 
     if (phaseNow === 'listening' || phaseNow === 'speaking') {
       if (level >= startThreshold) {
@@ -314,7 +320,7 @@ export function useVoiceConversation() {
           ? now - speechStartedAtRef.current
           : 0;
