 import type { ChatMessage } from '../types';
@@ -213,7 +213,7 @@ export function useVoiceConversation() {
         if (enabledRef.current) setPhaseBoth('listening');
         return;
       }
-      const result = await transcribeAudio(blob);
+      const result = await transcribeAudio(blob, 'recording.webm', 'en');
       const text = (result.text || '').trim();
       if (!text || text.length < 2) {
         if (enabledRef.current) setPhaseBoth('listening');
@@ -224,7 +224,12 @@ export function useVoiceConversation() {
       if (!enabledRef.current) return;
 
       setPhaseBoth('speaking');
